# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.

# Kunci enkripsi token Garmin sebelum disimpan ke database (AES-256-GCM).
# Wajib minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
# Kalau kunci berubah, semua akun harus login ulang.
GARMIN_TOKEN_SECRET=

# Proyek Supabase tempat token Garmin disimpan.
SUPABASE_URL=

# Secret key Supabase (melewati RLS). HANYA untuk server.
# Dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=
